# Test defaults. Infrastructure is mocked, so startup validation is disabled and
# the application boots without PostgreSQL, Redis, or NATS running.
APP_NAME=MIOS
APP_VERSION=0.1.0
APP_ENV=testing
DEBUG=false

HOST=127.0.0.1
PORT=8001

API_PREFIX=/api/v1

LOG_LEVEL=WARNING
LOG_JSON=false

STARTUP_VALIDATION=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mios
POSTGRES_PASSWORD=mios
POSTGRES_DB=mios_test
POSTGRES_POOL_SIZE=2
POSTGRES_MAX_OVERFLOW=0

TIMESCALEDB_ENABLED=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=15

NATS_SERVERS=nats://127.0.0.1:4222
NATS_CONNECT_TIMEOUT=1
NATS_MAX_RECONNECT_ATTEMPTS=0
