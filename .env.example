# --- Application -------------------------------------------------------------
APP_NAME=MIOS
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

API_PREFIX=/api/v1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# Structured JSON logs; enable outside local development.
LOG_JSON=false

# --- Startup -----------------------------------------------------------------
# Abort startup when a mandatory infrastructure component is unreachable.
STARTUP_VALIDATION=true

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mios
POSTGRES_PASSWORD=mios
POSTGRES_DB=mios

POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
POSTGRES_POOL_PRE_PING=true
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_ECHO=false

# --- TimescaleDB -------------------------------------------------------------
TIMESCALEDB_ENABLED=true

# --- Redis -------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# --- NATS JetStream ----------------------------------------------------------
# Comma-separated for a cluster.
NATS_SERVERS=nats://127.0.0.1:4222
NATS_CONNECT_TIMEOUT=5
# -1 retries forever.
NATS_MAX_RECONNECT_ATTEMPTS=-1
NATS_RECONNECT_TIME_WAIT=2
NATS_PING_INTERVAL=30

# --- Options Intelligence Engine ---------------------------------------------
# Master switch for the live engine. When true, the engine connects once a Fyers
# session exists (browser login), otherwise it waits. Set FYERS_USE_SIMULATOR=true
# to drive it from deterministic simulated data instead (development only).
OPTIONS_ENGINE_ENABLED=false
FYERS_USE_SIMULATOR=false

# --- Fyers API v3 — one-time app configuration -------------------------------
# Obtain these once from https://myapi.fyers.in/dashboard/. The access token is
# NOT configured here: authenticate via the browser at /api/v1/fyers/login and
# the token is stored automatically in data/fyers/session.json.
# The redirect URI MUST match the app config and point at the callback below,
# e.g. http://localhost:8000/api/v1/fyers/callback
# FYERS_CLIENT_ID=XXXXXXXXXX-100
# FYERS_SECRET_KEY=
# FYERS_REDIRECT_URI=http://localhost:8000/api/v1/fyers/callback
FYERS_REQUEST_TIMEOUT=10
# Absolute path (default targets the container's writable data volume). For
# local, non-Docker runs, override to a writable path, e.g. ./data/fyers/session.json
FYERS_SESSION_PATH=/app/data/fyers/session.json
FYERS_TOKEN_TTL_HOURS=12

# --- Instrument scope --------------------------------------------------------
NIFTY_SPOT_SYMBOL=NSE:NIFTY50-INDEX
OPTION_STRIKE_STEP=50
OPTION_STRIKE_COUNT=10
# Expiry as an epoch timestamp; leave unset for the nearest expiry.
# OPTION_EXPIRY_TIMESTAMP=

# --- Live engine -------------------------------------------------------------
ENGINE_POLL_INTERVAL_SECONDS=15
CANDLE_RESOLUTION_MINUTES=5
CANDLE_LOOKBACK_COUNT=60

# --- Market hours ------------------------------------------------------------
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
MARKET_TIMEZONE=Asia/Kolkata

# --- Unusual activity thresholds (percent change, except velocity) -----------
UNUSUAL_OI_CHANGE_PCT=100
UNUSUAL_VOLUME_CHANGE_PCT=100
UNUSUAL_PREMIUM_CHANGE_PCT=50
UNUSUAL_OI_VELOCITY_PER_MIN=5000

# --- Classification noise floor ----------------------------------------------
CLASSIFICATION_MIN_OI_CHANGE_PCT=2
CLASSIFICATION_MIN_PREMIUM_CHANGE_PCT=1

# --- Structure / Momentum ----------------------------------------------------
STRUCTURE_SWING_LOOKBACK=2
MOMENTUM_LOOKBACK_CANDLES=5
MOMENTUM_ACCELERATION_THRESHOLD=0.2

# --- CE/PE, Radar, Recommendation, No-Trade ----------------------------------
CE_PE_NEUTRAL_BAND_PCT=10
RADAR_TOP_N=5
RECOMMENDATION_TOP_N=5
RECOMMENDATION_MIN_EVIDENCE=2
NO_TRADE_RANK_TIE_MARGIN=1
NO_TRADE_MIN_REASONS=2
